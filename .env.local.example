# ---------------------------------------------------------------------------
# Required — the app will not capture without this
# ---------------------------------------------------------------------------

# Covers both models: whisper-large-v3 and the extractor. Free at console.groq.com
GROQ_API_KEY=

# Optional: override the extraction model if this one is unavailable
# GROQ_MODEL=openai/gpt-oss-120b


# ---------------------------------------------------------------------------
# Optional — the observability layer and the diagnostic portal
#
# Leave every one of these unset and the app still works. Capture simply runs
# unobserved: nothing is recorded server-side, no audio is retained, and
# /portal denies everyone. Diagnostics are never allowed to be the reason a
# transaction fails.
# ---------------------------------------------------------------------------

# Supavisor TRANSACTION pooler string, not the direct connection. The direct
# host is IPv6-only and unreachable from Vercel.
DATABASE_URL=

# Supabase project URL. Public — used to build the Storage upload URL.
NEXT_PUBLIC_SUPABASE_URL=

# Server-side only. New-format secret key (sb_secret_...), not the legacy
# service-role JWT. Bypasses RLS, so it must never reach the client bundle.
SUPABASE_SECRET_KEY=

# Gates /portal, which shows transcripts and amounts. Unset denies everyone —
# it fails closed on purpose, so a missing variable in production cannot leave
# the page open.
PORTAL_PASSWORD=

# Writes a .webm + .json per capture to .captures/ on local disk. DEFAULTS TO
# ON when unset. Superseded by Supabase Storage; set it to 0 anywhere deployed,
# since it is not consent-gated and silently no-ops on an ephemeral filesystem.
SAVE_CAPTURES=0

# Direct (non-pooled) connection, for running the SQL in supabase/ by hand.
# Nothing in the app reads this.
# DIRECT_URL=
