<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The widget records an expense without opening the app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${vaaniCleartext}"
        android:theme="@style/Theme.VaaniTrack">

        <!-- The website, full screen, as an app. The launch address comes from
             the intent when there is one (the widget sends the record address),
             and from here when there is not (the app icon). -->
        <activity
            android:name=".AppLauncher"
            android:clearTaskOnLaunch="true"
            android:exported="true">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/vaani_open_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/paper" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/paper" />

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the site open here rather than in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${vaaniHost}" />
            </intent-filter>
        </activity>

        <!-- Which sites this app may show without a browser bar. The matching
             half is the site's /.well-known/assetlinks.json. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- Listens for an expense when the tile is tapped. A foreground
             service of the microphone kind: Android shows its own indicator. -->
        <service
            android:name=".RecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Connects the tile to the website's settings. It has no screen of its
             own: the You screen opens it with a link and it hands straight back. -->
        <activity
            android:name=".SetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vaanitrack" android:host="setup" />
            </intent-filter>
        </activity>

        <!-- The home-screen tile. -->
        <receiver
            android:name=".RecordWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.vaanitrack.android.UNDO" />
                <action android:name="app.vaanitrack.android.NOOP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/record_widget_info" />
        </receiver>
    </application>
</manifest>
