<?xml version="1.0" encoding="utf-8"?>
<!-- The small Undo button: an ink outline and a 12dp corner (never below 12 on a button). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66AEDDC6">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper_raised" />
            <stroke
                android:width="2dp"
                android:color="@color/ink" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
