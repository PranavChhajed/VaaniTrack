<?xml version="1.0" encoding="utf-8"?>
<!-- The tile: ink fading to the app's deep green, with a faint light edge so it
     reads as a pane sitting on the wallpaper rather than a flat block. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#06362F"
        android:startColor="#1A1A1A"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#30FFFFFF" />
    <corners android:radius="30dp" />
</shape>
