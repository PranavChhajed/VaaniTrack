<?xml version="1.0" encoding="utf-8"?>
<!-- The tile is a card, as in the app: raised paper, a 2px ink border, a 32dp
     corner (docs/DESIGN.md: never below 32 on a card). Flat: no gradient, no
     shadow, no glow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper_raised" />
    <stroke
        android:width="2dp"
        android:color="@color/ink" />
    <corners android:radius="32dp" />
</shape>
