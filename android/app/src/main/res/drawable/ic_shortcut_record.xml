<?xml version="1.0" encoding="utf-8"?>
<!-- The waveform on an ink disc, so it reads on any launcher background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp"
        android:drawable="@drawable/ic_waveform" />
</layer-list>
