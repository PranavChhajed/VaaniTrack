<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: the system's own widget corner radius, so the tile
     matches the phone's other widgets and the launcher can animate it open. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#06362F"
        android:startColor="#1A1A1A"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#30FFFFFF" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
