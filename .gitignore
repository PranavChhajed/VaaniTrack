# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds no values and which README tells you to copy
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates
# ephemeral tunnel QR
phone-link.png

# Real device captures kept for offline accuracy work — audio, never commit
.captures/

# Android shell: the signing key and what it builds. The key is the app's
# identity; losing it means users cannot update, so it is backed up, never committed.
android/keystore.properties
android/*.jks
android/.gradle/
android/build/
android/app/build/
android/local.properties
