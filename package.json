{
  "name": "vaanitrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "worker:whatsapp": "tsx --env-file=.env.whatsapp.local scripts/whatsapp-worker.ts",
    "test:accounts": "tsx scripts/account-local.test.ts && tsx scripts/account-auth.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:https": "next dev --experimental-https --hostname 0.0.0.0",
    "dev:phone": "node scripts/dev-https.mjs",
    "dev:tunnel": "next build && node scripts/dev-tunnel.mjs",
    "dev:tunnel:hot": "node scripts/dev-tunnel.mjs --dev"
  },
  "dependencies": {
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cloudflared": "^0.7.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
